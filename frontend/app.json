{
  "expo": {
    "name": "SKILKI",
    "slug": "duelo-v7sn6v",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-skilki.png",
    "scheme": "duelo",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Partage des photos dans le mur communautaire",
        "CFBundleLocalizations": [
          "fr",
          "en",
          "es",
          "de",
          "pt",
          "it",
          "ar",
          "ja",
          "ko",
          "zh-Hans"
        ],
        "CFBundleDevelopmentRegion": "fr"
      },
      "bundleIdentifier": "com.skilki.app",
      "buildNumber": "1",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.skilki.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-skilki.png",
        "backgroundColor": "#071F26"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-skilki.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#071F26"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Partage des photos dans le mur communautaire",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "373a1773-3a32-42d5-a5b9-f80e4e070ebc"
      }
    },
    "owner": "daud31s-organization"
  }
}
